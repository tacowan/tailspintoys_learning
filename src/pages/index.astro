---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import {
  getAllCategories,
  getAllGames,
  getAllPublishers,
} from '../lib/games';

export const prerender = true;

const db = getDatabase();
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
const selectedCategoryIds: number[] = [];
const games = await getAllGames(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form
        method="get"
        class="mb-8 rounded-xl border border-slate-700 bg-slate-800 p-6"
        data-testid="game-filters"
      >
        <div class="grid gap-6 md:grid-cols-2">
          <fieldset>
            <legend class="mb-3 text-lg font-medium text-slate-100">
              Filter by category
            </legend>
            <div class="grid gap-3 sm:grid-cols-2">
              {categories.map((category) => (
                <label class="flex items-center gap-3 text-slate-200">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    checked={selectedCategoryIds.includes(category.id)}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="publisher-filter" class="mb-3 block text-lg font-medium text-slate-100">
              Filter by publisher
            </label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>
                  {publisher.name}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="apply-game-filters"
          >
            Apply filters
          </button>
          <a
            href="/"
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-game-filters"
          >
            Clear filters
          </a>
        </div>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      {games.length > 0 && (
        <p
          class="rounded-xl border border-slate-700 bg-slate-800 p-6 text-slate-300"
          data-testid="filtered-empty-state"
          hidden
        >
          No games match the selected filters.
        </p>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  const applyFilters = (search: string): void => {
    const params = new URLSearchParams(search);
    const selectedCategories = new Set(params.getAll('category'));
    const selectedPublisher = params.get('publisher') ?? '';
    let visibleCards = 0;

    form?.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });

    const publisherInput = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');
    if (publisherInput) {
      publisherInput.value = selectedPublisher;
    }

    cards.forEach((card) => {
      const categoryMatches =
        selectedCategories.size === 0 ||
        selectedCategories.has(card.dataset.gameCategoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' ||
        selectedPublisher === (card.dataset.gamePublisherId ?? '');
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      if (visible) {
        visibleCards += 1;
      }
    });

    if (emptyState) {
      emptyState.hidden = visibleCards > 0;
    }
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const params = new URLSearchParams();
    for (const [key, value] of new FormData(form).entries()) {
      if (typeof value === 'string') {
        params.append(key, value);
      }
    }
    const search = params.toString();
    history.pushState(null, '', search ? `/?${search}` : '/');
    applyFilters(search);
  });

  window.addEventListener('popstate', () => applyFilters(window.location.search));
  applyFilters(window.location.search);
</script>
